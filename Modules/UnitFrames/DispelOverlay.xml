<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<AnimationGroup name="WT_DispelMarchingAnimTemplate" looping="REPEAT" virtual="true">
		<TextureCoordTranslation childKey="Top" duration="1" offsetU="-1" offsetV="0"/>
		<TextureCoordTranslation childKey="Bottom" duration="1" offsetU="1" offsetV="0"/>
		<TextureCoordTranslation childKey="Left" duration="1" offsetU="0" offsetV="1"/>
		<TextureCoordTranslation childKey="Right" duration="1" offsetU="0" offsetV="-1"/>
	</AnimationGroup>

	<Frame name="WT_DispelAnimatedBorderTemplate" inherits="MarchingAntsTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="verticalAsset" value="UI-RaidFrames-SingleAnt-Vertical" type="string"/>
			<KeyValue key="horizontalAsset" value="UI-RaidFrames-SingleAnt-Horiz" type="string"/>

			<KeyValue key="leftOffsetP1X" value="-1" type="number"/>
			<KeyValue key="leftOffsetP2X" value="-1" type="number"/>

			<KeyValue key="rightOffsetP1X" value="1" type="number"/>
			<KeyValue key="rightOffsetP2X" value="1" type="number"/>

			<KeyValue key="topOffsetP1Y" value="1" type="number"/>
			<KeyValue key="topOffsetP2Y" value="1" type="number"/>

			<KeyValue key="bottomOffsetP1Y" value="-1" type="number"/>
			<KeyValue key="bottomOffsetP2Y" value="-1" type="number"/>
		</KeyValues>
	</Frame>
</Ui>
